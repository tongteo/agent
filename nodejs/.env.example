# ═══════════════════════════════════════════════
# agent-cli — Provider Configuration
# ═══════════════════════════════════════════════

# 9Router provides the local OpenAI-compatible API. Copy the API key from its dashboard.
OPENAI_API_KEY=your-key-from-9router-dashboard
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_MODEL=kr/claude-sonnet-4.5            # Example only; choose an enabled model

# ═══════════════════════════════════════════════
# Wolfram Alpha — calculator tool integration
# ═══════════════════════════════════════════════
# Get your free App ID at https://developer.wolframalpha.com/
# Calculator tool falls back to Wolfram Alpha when local eval cannot
# handle the expression (e.g. integrals, derivatives, symbolic math).
WOLFRAM_APP_ID=your-wolfram-alpha-app-id    # Optional; do not commit real credentials
